const SHEET="Records";
function doGet(e){const p=e.parameter||{},cb=String(p.callback||"");let out;try{if(p.action!=="stats")throw Error("Unknown action");out=stats_()}catch(err){out={ok:false,error:String(err.message||err)}}if(cb&&/^[A-Za-z_$][\w$]*$/.test(cb))return ContentService.createTextOutput(cb+"("+JSON.stringify(out)+");").setMimeType(ContentService.MimeType.JAVASCRIPT);return json_(out)}
function doPost(e){try{const b=JSON.parse(e.postData.contents||"{}");const sh=sheet_();if(b.action==="updateRetest")return update_(sh,b);if(b.action!=="submit")throw Error("Unknown action");if(!["AASE"].includes(b.role))throw Error("Role must be AASE.");if(!STREAMS_().includes(b.stream))throw Error("Select a valid stream.");if(!["On-campus","Off-campus"].includes(b.campus))throw Error("Select campus type.");if(!["Yes","No"].includes(b.gear))throw Error("Select Gear Up Yes or No.");const id=b.section==="retest"?"RT-"+Date.now():"FC-"+Date.now();if(b.section==="first")sh.appendRow([id,new Date(),"first",b.role,b.stream,b.campus,b.gear,"","","","",""]);else if(b.section==="retest"){sh.appendRow([id,new Date(),"retest",b.role,b.stream,b.campus,b.gear,date_(b.hon),date_(b.caps),date_(b.viva),date_(b.result),""]);}else throw Error("Invalid section.");return json_({ok:true,recordId:id})}catch(err){return json_({ok:false,error:String(err.message||err)})}}
function update_(sh,b){const id=String(b.recordId||"").trim();if(!/^RT-\d+$/.test(id))throw Error("Enter a valid retest record ID.");const rows=sh.getDataRange().getValues();for(let i=1;i<rows.length;i++){if(String(rows[i][0])===id&&rows[i][2]==="retest"){sh.getRange(i+1,8,1,4).setValues([[date_(b.hon),date_(b.caps),date_(b.viva),date_(b.result)]]);return json_({ok:true})}}throw Error("Retest record ID not found.")}
function date_(v){if(!v)return "";const x=String(v);if(!/^\d{4}-\d{2}-\d{2}$/.test(x))throw Error("Use a valid date or leave blank.");const d=new Date(x+"T00:00:00Z");if(isNaN(d.getTime())||d.toISOString().slice(0,10)!==x)throw Error("Invalid date.");return x}
function STREAMS_(){return ["Mobile Application Development with React Native","Front end engineering with angular","SAP SMARTFIELD (Tech Arch) cohort 1& 2","SAP BTP Integration Development","SAP Master Data Governance","SAP Trade Execution","Cloud native microservices engineering","SAP Order Processing","SAP BTP Application Development","Frontend engineering with React","SAP S/4HANA Extended Warehouse Management","SAP BTP AI Development","SAP Full Stack Development","Full Stack Informatica","Oracle Fusion Cloud ERP Financials","IICS","SAP Production Planning and Quality Management","Sap Smartfield Transformation","Full Stack Cloud Data Engineer - GCP","Full Stack Data Engineer - Hadoop & spark","Full Stack Data Engineer - Snowflake","Full Stack Cloud Data Engineer - Databricks","Python full stack","Java full stack + GenAI","DotNet Full Stack","Oracle Fusion Cloud Applications SCM","Oracle Analytics Cloud & Data AI Platform","Oracle Fusion Cloud Applications EPM","Salesforce pss and health","Salesforce Comms Cloud","Agentforce Revenue Management","Oracle Fusion Cloud Applications PAAS","Full stack web development - 1","Oracle Fusion Cloud Applications TECH","SAP Business Data Cloud","SAP Procurement and invoicing","Full Stack Gen AI Engineer","Oracle cloud application development integration","Sap S/4 Hana Transportation Management with bn4l"]}
function sheet_(){const id=PropertiesService.getScriptProperties().getProperty("SPREADSHEET_ID");if(!id)throw Error("Set SPREADSHEET_ID in Script Properties.");const ss=SpreadsheetApp.openById(id);let sh=ss.getSheetByName(SHEET);if(!sh){sh=ss.insertSheet(SHEET);sh.appendRow(["Record ID","Timestamp","Section","Role","Stream","Campus","Gear Up","HON Date","Caps Date","VIVA Date","Result Date","Notes"])}return sh}
function stats_(){const rows=sheet_().getDataRange().getValues().slice(1),streams=STREAMS_(),first={},retest={};streams.forEach(s=>{first[s]={"On-campus":{Yes:0,No:0},"Off-campus":{Yes:0,No:0}};retest[s]={"On-campus":{Yes:{Completed:0,"Not completed":0},No:{Completed:0,"Not completed":0}},"Off-campus":{Yes:{Completed:0,"Not completed":0},No:{Completed:0,"Not completed":0}}}});rows.forEach(r=>{const section=r[2],stream=r[4],campus=r[5],gear=r[6];if(!streams.includes(stream)||!["On-campus","Off-campus"].includes(campus)||!["Yes","No"].includes(gear))return;if(section==="first")first[stream][campus][gear]++;if(section==="retest"){const done=String(r[10]||"").trim()!==""?"Completed":"Not completed";retest[stream][campus][gear][done]++}});return {ok:true,first,retest}}
function json_(v){return ContentService.createTextOutput(JSON.stringify(v)).setMimeType(ContentService.MimeType.JSON)}